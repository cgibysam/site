---
import { existsSync } from 'node:fs';
import ProductImage from '../components/ProductImage.astro';
import WatchAnatomy from '../components/WatchAnatomy.astro';
import WatchProduct from '../components/WatchProduct.astro';
import WatchDialogs from '../components/WatchDialogs.astro';
import TemplateSwitcher from '../components/TemplateSwitcher.astro';
import '../styles/global.css';
const filmReady = existsSync('public/media/velorne/assembly-film.mp4');
const studies = [
  { image: 'macro-case', title: 'An edge worth a second look.', label: 'Form', description: 'Brushed surfaces meet polished edges in the Study 01 case concept.' },
  { image: 'macro-dial', title: 'Less on the dial. More to notice.', label: 'Dial', description: 'A graphite dial, applied markers and faceted hands. Every element has room to breathe.' },
  { image: 'macro-movement', title: 'A whole world beneath.', label: 'Architecture', description: 'An illustrative arrangement of wheels, bridges and layers, revealed beneath the face.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VELORNE Study 01 — A closer look at time.</title>
    <meta name="description" content="Meet VELORNE Study 01, a fictional mechanical watch concept. Explore its graphite dial, sculpted case and scroll-controlled assembly, from the outside in." />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#fafafc" />
    <meta property="og:title" content="VELORNE Study 01 — A closer look at time." />
    <meta property="og:description" content="A fictional mechanical watch concept. Beautifully considered, from the outside in." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="#top" aria-label="VELORNE home">VELORNE</a>
        <nav class="nav" aria-label="Primary"><a href="#study">Overview</a><a href="#materials">Design</a><a href="#anatomy">Inside the watch</a><a class="nav__cta" href="#details">Explore Study 01</a></nav>
        <details class="mobile-nav"><summary>Menu <span aria-hidden="true">+</span></summary><nav class="mobile-nav__panel" aria-label="Mobile"><a href="#study">Overview</a><a href="#materials">Design</a><a href="#anatomy">Inside the watch</a><a href="#details">Explore Study 01</a></nav></details>
      </div>
    </header>
    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero__copy wrap">
          <p class="hero__name">VELORNE <span>Study 01</span></p>
          <h1 id="hero-title">A closer look<br />at time.</h1>
          <p class="hero__description">Beautifully considered. From the outside in.</p>
          <div class="hero__actions"><a class="button" href="#anatomy">Explore the watch</a>{filmReady && <button class="link-button" type="button" data-play-film hidden>Watch the film <span class="play-icon" aria-hidden="true">▶</span></button>}</div>
        </div>
        <div class="hero__visual" data-hero-visual><div class="hero__tilt"><ProductImage name="front" alt="The face of VELORNE Study 01, with a graphite dial, polished case edges and an articulated metal bracelet" eager sizes="(max-width: 700px) 100vw, 800px" /></div></div>
        <div class="hero__foot wrap"><span>Obsidian. A study in contrast.</span><a href="#study" aria-label="Scroll to overview"><span aria-hidden="true">↓</span></a></div>
      </section>
      <section class="intro wrap section-space" id="study" aria-labelledby="study-title">
        <p class="eyebrow">Meet Study 01.</p>
        <h2 id="study-title">Nothing to add.<br /><span>So much to discover.</span></h2>
        <p class="body-copy">A dark dial. A sculpted case. Light moving across a polished edge. A mechanical watch concept that invites you to slow down — and look a little closer.</p>
        <p class="concept-note">A fictional design study by VELORNE.</p>
      </section>
      <section id="materials" class="materials section-space" aria-labelledby="materials-title">
        <div class="section-heading wrap"><h2 id="materials-title">Get closer.</h2><p>It's all in the details.</p></div>
        <div class="material-grid" data-highlights tabindex="0" aria-label="Design highlights. Scroll horizontally for more.">
          {studies.map(({ image, title, label, description }, index) => <article class="highlight-card">
            <ProductImage name={image} alt={description} sizes="(max-width: 700px) 85vw, 460px" />
            <div class="highlight-card__copy"><p class="eyebrow">{label}</p><h3>{title}</h3></div>
            <details class="highlight-detail"><summary><span class="sr-only">Read about {label.toLowerCase()}</span><span aria-hidden="true">+</span></summary><div><p>{description}</p><span class="highlight-detail__number" aria-hidden="true">0{index + 1}</span></div></details>
          </article>)}
        </div>
        <div class="highlight-controls wrap" data-highlight-controls hidden><button type="button" data-slide="-1" aria-label="Previous design highlight">‹</button><button type="button" data-slide="1" aria-label="Next design highlight">›</button></div>
      </section>
      <WatchAnatomy />
      <WatchProduct />
      <section class="closing wrap"><p class="eyebrow">VELORNE Study 01</p><h2>There’s always<br /><span>more to see.</span></h2><a class="link-button" href="#top">Take another look <span aria-hidden="true">↑</span></a></section>
    </main>
    <WatchDialogs />
    <footer class="footer"><div class="wrap footer__inner"><a class="wordmark" href="#top">VELORNE</a><p>A fictional concept by CGI by Sam.<br />An Agency OS design study.</p><a href="#details">Explore Study 01 <span aria-hidden="true">↗</span></a></div></footer>
    <TemplateSwitcher current="studio" />
    <script>import '../scripts/home';</script>
  </body>
</html>
