{
  "brand": "inerg",
  "site": "inerg/",
  "source": "inerg/css/styles.css :root and [data-theme=\"dark\"]",
  "colorScheme": "light dark",
  "color": {
    "light": {
      "paper": "#f2f0e9",
      "paper-2": "#e8e5db",
      "ink": "#0e1411",
      "steel": "#59635d",
      "line": "#cfcbbf",
      "green": "#0e7a3e",
      "green-deep": "#0a5a2e",
      "green-soft": "rgba(14, 122, 62, .12)",
      "lime": "#8be04a",
      "on-dark": "#f1f3ec",
      "on-dark-muted": "#c2cac4"
    },
    "dark": {
      "paper": "#0b0f0d",
      "paper-2": "#131916",
      "ink": "#edefe8",
      "steel": "#97a19a",
      "line": "#242c27",
      "green": "#35c26b",
      "green-deep": "#14824a",
      "green-soft": "rgba(53, 194, 107, .14)",
      "lime": "#a2f35f"
    }
  },
  "font": {
    "display": "\"Archivo\", \"Arial Black\", Impact, sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "layout": {
    "gutter": "clamp(16px, 4vw, 56px)",
    "max": "1400px"
  },
  "motion": {
    "ease": "cubic-bezier(.16, 1, .3, 1)"
  }
}
